local id = 'projects/gcp-public-data-weathernext/assets/PARDIG_1_LR';
local subdir = 'gcp-public-data-weathernext';

local ee_const = import 'earthengine_const.libsonnet';
local ee = import 'earthengine.libsonnet';
local spdx = import 'spdx.libsonnet';
local units = import 'units.libsonnet';

local basename = std.strReplace(id, '/', '_');
local base_filename = basename + '.json';
local self_ee_catalog_url = ee_const.ee_catalog_url + basename;
local catalog_subdir_url = ee_const.catalog_base + subdir + '/';
local parent_url = catalog_subdir_url + 'catalog.json';
local self_url = catalog_subdir_url + base_filename;

local license = spdx.cc_by_4_0;

{
  'gee:user_uploaded': true,
  stac_version: ee_const.stac_version,
  type: ee_const.stac_type.collection,
  stac_extensions: [
    ee_const.ext_eo,
    ee_const.ext_sci,
  ],
  id: id,
  title: 'PARDIG LR (Long-Record)',
  'gee:type': ee_const.gee_type.image_collection,
  // TODO(mahrsee): Add links to the paper and the acknowledgements page once
  // available.
  description: |||
    PARDIG (Precipitation AI Reanalysis - Densely Inferred GPM) is an
    experimental dataset of global AI-driven precipitation estimates by Google
    DeepMind and Google Research, produced by the model described in: *Global
    Precipitation Estimates Learned from Sparse Satellite Observations*.

    PARDIG is produced by an AI model that is trained to predict precipitation
    estimates from the Combined Radar-Radiometer Algorithm (CORRA), part of the
    NASA/JAXA Global Precipitation Measurement (GPM) Core Observatory.
    PARDIG-LR relies on ECMWF's ERA5, NOAA's GridSat-B1, and a global mosaic of
    polar-orbiting (LEO) microwave sounder observations as its inputs. PARDIG
    precipitation estimates are provided at a 15 minute cadence and 0.1&deg;
    spatial resolution.

    This image collection provides the full historical archive of PARDIG-LR
    (Long-Record) from 1999 through 2023. The dataset is also available in Zarr
    format in our Google Cloud Storage bucket (`gs://pardig_1/LR/`). The
    companion dataset, PARDIG-NRT (Near-Real-Time), is also available on
    [Earth Engine](https://developers.google.com/earth-engine/datasets/catalog/projects_gcp-public-data-weathernext_assets_PARDIG_1_NRT)
    and on Google Cloud Storage (`gs://pardig_1/NRT/`).

    Both datasets are publicly available in the Earth Engine Data Catalog and
    on Google Cloud Storage. Users can access them via their Google Cloud
    account immediately, without needing to explicitly apply for access.

    For more details about PARDIG and related products, visit the
    [Developer Guide](https://developers.google.com/weathernext/guides/pardig).

    **Acknowledgements**

    This experimental dataset was generated by a model using data and products
    of the European Centre for Medium-Range Weather Forecasts (ECMWF), as well
    as additional third-party providers. For a full list of attribution and
    acknowledgements, please see our acknowledgements page.
  |||,
  license: license.id,
  links: ee.standardLinks(subdir, id) + [
    ee.link.license(license.reference),
  ],
  'gee:categories': ['weather-and-climate'],
  keywords: [
    'climate',
    'flood',
    'gpm',
    'hydrology',
    'meteorology',
    'pardig',
    'precipitation',
    'radar',
    'rain',
    'rainfall',
    'satellite',
    'snowfall',
    'weather',
    'weathernext',
  ],
  providers: [
    ee.producer_provider('Google', 'https://developers.google.com/weathernext'),
    ee.host_provider(self_ee_catalog_url),
  ],
  extent: ee.extent_global('1999-01-01T00:00:00Z', '2023-12-31T23:45:00Z'),
  summaries: {
    gsd: [11132],
    'gee:schema': [
      {
        name: 'start_time',
        description: |||
          The valid time of the precipitation estimate.
        |||,
        type: ee_const.var_type.string,
      },
      {
        name: 'end_time',
        description: |||
          The valid time of the precipitation estimate.
        |||,
        type: ee_const.var_type.string,
      },
      {
        name: 'ingestion_time_utc',
        description: |||
          The time when this data was ingested into Earth Engine.
        |||,
        type: ee_const.var_type.double,
      },
      {
        name: 'B0',
        description: |||
          The band name: precipitation.
        |||,
        type: ee_const.var_type.string,
      },
    ],
    'eo:bands': [
      {
        name: 'precipitation',
        description: |||
          Instantaneous precipitation rate at the valid timestamp (start_time).
        |||,
        'gee:units': units.meter_per_hour,
      },
    ],
    'gee:visualizations': [
      {
        display_name: 'Precipitation',
        lookat: {
          lat: 26,
          lon: -78,
          zoom: 4,
        },
        image_visualization: {
          band_vis: {
            min: [
              0.001,
            ],
            max: [
              0.015,
            ],
            palette: [
              '000096', '0064ff', '00b4ff', '33db80', '9beb4a',
              'ffeb00', 'ffb300', 'ff6400', 'eb1e00', 'af0000',
            ],
            bands: [
              'precipitation',
            ],
          },
        },
      },
    ],
  },
  'sci:citation': |||
    If you disclose findings arising from PARDIG, you must cite
    "&copy; 2026 Google LLC's machine learning models used to create the
    experimental data made available at
    [https://developers.google.com/earth-engine/datasets/catalog/projects_gcp-public-data-weathernext_assets_PARDIG_1_LR](https://developers.google.com/earth-engine/datasets/catalog/projects_gcp-public-data-weathernext_assets_PARDIG_1_LR)
    under CC BY 4.0 licence terms. This data is intended for experimental
    modelling only and is not intended, validated, or approved for real
    world use."
  |||,
  'gee:interval': {
    type: 'cadence',
    unit: 'minute',
    interval: 15,
  },
  'gee:terms_of_use': ee.gee_terms_of_use(license) + '\n\n' + |||
    PARDIG is licensed under the
    [Creative Commons Attribution International License, Version 4.0 (CC BY 4.0)](https://creativecommons.org/licenses/by/4.0/deed.en).

    **Third-party materials**

    Use of the third-party materials referred to in the Acknowledgements
    section may be governed by separate terms and conditions or license
    provisions. Your use of the third-party materials is subject to any such
    terms and you should check that you can comply with any applicable
    restrictions or terms and conditions before use.
  |||,
  'gee:status': 'incomplete',
}
